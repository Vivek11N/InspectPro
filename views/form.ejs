<%
  function safeOptions(raw) {
    if (!raw) return [];
    if (typeof raw !== 'string') return raw;
    const trimmed = raw.trim();
    try {
      const parsed = JSON.parse(trimmed);
      return Array.isArray(parsed) ? parsed : [String(parsed)];
    } catch {
      return trimmed.split(',').map(s => s.trim()).filter(Boolean);
    }
  }
%>

<%- include('partials/header', { title: category ? category.name : 'Form' }) %>

<div class="form-header">
  <h1><%= category ? category.name : 'Inspection Form' %></h1>
  <% if (category && category.description) { %>
    <div class="subtitle"><%= category.description %></div>
  <% } %>
</div>

<form method="POST" action="/form/<%= slug %>/step" class="question-form" id="dynamicForm">
  <input type="hidden" name="_group" value="<%= group %>">
  <input type="hidden" name="_answers" value="<%= encodeURIComponent(JSON.stringify(answers)) %>">
  
  <% if (questions && questions.length > 0) { %>
    <% questions.forEach(q => { %>
      <div class="question-block" id="block_<%= q.id %>" 
           data-condition-question="<%= q.conditional_on_question_id || '' %>" 
           data-condition-value="<%= q.conditional_on_value || '' %>">
        <label class="question-label" for="q_<%= q.id %>">
          <%= q.question_text %>
          <% if (q.is_required) { %><span class="required">*</span><% } %>
        </label>

        <% if (q.field_type === 'text') { %>
          <input type="text" id="q_<%= q.id %>" name="<%= q.id %>" class="form-input"
                 value="<%= answers[String(q.id)] || '' %>"
                 <%= q.is_required ? 'required' : '' %> />

        <% } else if (q.field_type === 'textarea') { %>
          <textarea id="q_<%= q.id %>" name="<%= q.id %>" class="form-input form-textarea"
                    <%= q.is_required ? 'required' : '' %>><%= answers[String(q.id)] || '' %></textarea>

        <% } else if (q.field_type === 'number') { %>
          <input type="number" id="q_<%= q.id %>" name="<%= q.id %>" class="form-input"
                 value="<%= answers[String(q.id)] || '' %>"
                 <%= q.is_required ? 'required' : '' %> />

        <% } else if (q.field_type === 'yesno') { %>
          <div class="radio-group">
            <label class="radio-option">
              <input type="radio" name="<%= q.id %>" value="Yes"
                     <%= answers[String(q.id)] === 'Yes' ? 'checked' : '' %>
                     <%= q.is_required ? 'required' : '' %> /> Yes
            </label>
            <label class="radio-option">
              <input type="radio" name="<%= q.id %>" value="No"
                     <%= answers[String(q.id)] === 'No' ? 'checked' : '' %>
                     <%= q.is_required ? 'required' : '' %> /> No
            </label>
          </div>

        <% } else if (q.field_type === 'select' && q.options) { %>
          <select id="q_<%= q.id %>" name="<%= q.id %>" class="form-input"
                  <%= q.is_required ? 'required' : '' %>>
            <option value="">-- Select --</option>
            <% safeOptions(q.options).forEach(opt => { %>
              <option value="<%= opt %>" <%= answers[String(q.id)] === opt ? 'selected' : '' %>><%= opt %></option>
            <% }) %>
          </select>

        <% } else if (q.field_type === 'radio' && q.options) { %>
          <div class="radio-group">
            <% safeOptions(q.options).forEach(opt => { %>
              <label class="radio-option">
                <input type="radio" name="<%= q.id %>" value="<%= opt %>"
                       <%= answers[String(q.id)] === opt ? 'checked' : '' %>
                       <%= q.is_required ? 'required' : '' %> /> <%= opt %>
              </label>
            <% }) %>
          </div>
        <% } %>

      </div>
    <% }) %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Next</button>
    </div>
  <% } else { %>
    <div class="alert alert-info">No questions found for this category.</div>
  <% } %>
</form>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('dynamicForm');
    if (!form) return;
    function updateConditionalQuestions() {
      const blocks = form.querySelectorAll('.question-block');
      blocks.forEach(block => {
        const conditionQuestion = block.dataset.conditionQuestion; // question ID
        const conditionValue    = block.dataset.conditionValue;
        if (conditionQuestion && conditionValue) {
          // Find the input whose name equals the condition question ID
          const input = form.querySelector(
            `input[name="${conditionQuestion}"], select[name="${conditionQuestion}"], textarea[name="${conditionQuestion}"]`
          );
          if (input) {
            let value = '';
            if (input.type === 'radio' || input.type === 'checkbox') {
              const checked = form.querySelector(`input[name="${conditionQuestion}"]:checked`);
              value = checked ? checked.value : '';
            } else {
              value = input.value;
            }
            const matches = String(value).toLowerCase() === String(conditionValue).toLowerCase();
            block.style.display = matches ? 'block' : 'none';
            // Toggle required attribute so hidden fields don't block form submit
            const requiredInputs = block.querySelectorAll('input[required], select[required], textarea[required]');
            requiredInputs.forEach(inp => {
              if (!matches) {
                inp.removeAttribute('required');
              } else {
                inp.setAttribute('required', 'required');
              }
            });
          }
        } else {
          block.style.display = 'block';
        }
      });
    }
    form.addEventListener('change', updateConditionalQuestions);
    form.addEventListener('input',  updateConditionalQuestions);
    updateConditionalQuestions();
  });
</script>

<%- include('partials/footer') %>
