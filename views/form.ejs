<%- include('partials/header', { title: category.name + ' – Step ' + group }) %>

<div class="form-header">
  <div class="breadcrumb">
    <a href="/">← Categories</a> / <strong><%= category.name %></strong>
  </div>
  <h1><%= category.name %> Inspection</h1>
  <div class="step-indicator">
    <% for(let i = 1; i <= maxGroup; i++) { %>
      <span class="step-dot <%= i === group ? 'active' : (i < group ? 'done' : '') %>">
        <%= i %>
      </span>
    <% } %>
    <span class="step-label">Step <%= group %> of <%= maxGroup %></span>
  </div>
</div>

<% if (questions.length === 0) { %>
  <div class="alert alert-info">
    No questions for this step.
    <a href="/admin/questions/new">Add questions</a> in the admin panel.
  </div>
  <form method="POST" action="/form/<%= slug %>/step">
    <input type="hidden" name="_group"   value="<%= group %>">
    <input type="hidden" name="_answers" value="<%= JSON.stringify(answers) %>">
    <button type="submit" class="btn btn-primary">
      <%= isLastGroup ? 'Continue to Images →' : 'Next Step →' %>
    </button>
  </form>
<% } else { %>

<form method="POST" action="/form/<%= slug %>/step" class="question-form" id="questionForm">
  <input type="hidden" name="_group"   value="<%= group %>">
  <input type="hidden" name="_answers" value="<%= JSON.stringify(answers).replace(/"/g, '&quot;') %>">

  <% const stepFieldNames = questions.map(qq => qq.field_name); %>

  <% questions.forEach((q) => { %>
  <%
    // Does this question have a condition at all?
    const hasCond = !!(q.conditional_on_field && q.conditional_on_value);
    // Is the field it depends on also on THIS step? If so, JS handles it.
    const condOnSameStep = hasCond && stepFieldNames.includes(q.conditional_on_field);
    // Start hidden only when the dependency is on the same step
    // (cross-step dependencies were already resolved server-side).
    const startHidden = condOnSameStep;
  %>
  <div class="question-block"
       data-field="<%= q.field_name %>"
       data-conditional-field="<%= condOnSameStep ? q.conditional_on_field : '' %>"
       data-conditional-value="<%= condOnSameStep ? q.conditional_on_value  : '' %>"
       style="<%= startHidden ? 'display:none;' : '' %>">

    <label class="question-label">
      <%= q.question_text %>
      <% if (q.is_required) { %><span class="required">*</span><% } %>
    </label>

    <% const currentVal = answers[q.field_name] || ''; %>

    <% if (q.field_type === 'text') { %>
      <input type="text" name="<%= q.field_name %>"
             value="<%= currentVal %>"
             class="form-input"
             <%= (q.is_required && !startHidden) ? 'required' : '' %> />

    <% } else if (q.field_type === 'number') { %>
      <input type="number" name="<%= q.field_name %>"
             value="<%= currentVal %>"
             class="form-input"
             <%= (q.is_required && !startHidden) ? 'required' : '' %> />

    <% } else if (q.field_type === 'textarea') { %>
      <textarea name="<%= q.field_name %>"
                class="form-input form-textarea"
                rows="4"
                <%= (q.is_required && !startHidden) ? 'required' : '' %>><%= currentVal %></textarea>

    <% } else if (q.field_type === 'yesno') { %>
      <div class="radio-group">
        <label class="radio-option">
          <input type="radio" name="<%= q.field_name %>" value="Yes"
                 <%= currentVal === 'yes' ? 'checked' : '' %>
                 <%= (q.is_required && !startHidden) ? 'required' : '' %> />
          <span>Yes</span>
        </label>
        <label class="radio-option">
          <input type="radio" name="<%= q.field_name %>" value="No"
                 <%= currentVal === 'no' ? 'checked' : '' %> />
          <span>No</span>
        </label>
      </div>

    <% } else if (q.field_type === 'radio') { %>
      <% const ropts = q.options ? JSON.parse(q.options) : []; %>
      <div class="radio-group">
        <% ropts.forEach((opt, oidx) => { %>
        <label class="radio-option">
          <input type="radio" name="<%= q.field_name %>"
                 value="<%= opt %>"
                 <%= currentVal === opt ? 'checked' : '' %>
                 <%= (q.is_required && !startHidden && oidx === 0) ? 'required' : '' %> />
          <span><%= opt %></span>
        </label>
        <% }) %>
      </div>

    <% } else if (q.field_type === 'select') { %>
      <% const sopts = q.options ? JSON.parse(q.options) : []; %>
      <select name="<%= q.field_name %>" class="form-input"
              <%= (q.is_required && !startHidden) ? 'required' : '' %>>
        <option value="">— Select —</option>
        <% sopts.forEach(opt => { %>
          <option value="<%= opt %>" <%= currentVal === opt ? 'selected' : '' %>><%= opt %></option>
        <% }) %>
      </select>
    <% } %>
  </div>
  <% }) %>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">
      <%= isLastGroup ? 'Continue to Images →' : 'Next Step →' %>
    </button>
  </div>
</form>
<% } %>

<%- include('partials/footer') %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('questionForm');
    if (!form) return;

    const questionBlocks = Array.from(form.querySelectorAll('.question-block'));

    // Store each input's original `required` state once, so we can
    // restore it correctly when the block becomes visible again.
    questionBlocks.forEach(block => {
      block.querySelectorAll('input, select, textarea').forEach(el => {
        el.dataset.wasRequired = el.required ? 'true' : 'false';
      });
    });

    // Toggle required on every input inside a block.
    // Hidden fields must never be required or they block submission.
    function setBlockRequired(block, isVisible) {
      block.querySelectorAll('input, select, textarea').forEach(el => {
        el.required = isVisible && el.dataset.wasRequired === 'true';
      });
    }

    // Get the current value of any named field in the form.
    function getFieldValue(fieldName) {
      const checked = form.querySelector(`[name="${fieldName}"]:checked`);
      if (checked) return checked.value;
      const el = form.querySelector(`[name="${fieldName}"]`);
      return el ? el.value : '';
    }

    function updateVisibility() {
      questionBlocks.forEach(block => {
        const condField = block.dataset.conditionalField;
        const condValue = block.dataset.conditionalValue;

        if (condField && condValue) {
          const actual  = getFieldValue(condField);
         const normalize = (v) => (v || '').toString().trim().toLowerCase();

const visible = normalize(actual) === normalize(condValue);
          block.style.display = visible ? '' : 'none';
          setBlockRequired(block, visible);
        } else {
          // No condition — always visible
          block.style.display = '';
          setBlockRequired(block, true);
        }
      });
    }

    // Re-evaluate on any user interaction
    form.addEventListener('change', updateVisibility);
    form.addEventListener('input',  updateVisibility);

    // Run once on load to handle pre-filled answers
    updateVisibility();
  });
</script>
