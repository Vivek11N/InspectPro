<%- include('../../partials/header', { title: 'Manage Questions' }) %>

<div class="page-header">
  <h1>Manage Questions</h1>
  <a href="/admin/questions/new" class="btn btn-primary">+ Add Question</a>
</div>

<% if (questions.length === 0) { %>
  <div class="alert alert-info">No questions yet. <a href="/admin/questions/new">Add the first one.</a></div>
<% } %>

<% 
  // Group by category
  const byCategory = {};
  questions.forEach(q => {
    if (!byCategory[q.category_name]) byCategory[q.category_name] = [];
    byCategory[q.category_name].push(q);
  });
  Object.keys(byCategory).forEach(catName => {
%>
<section class="admin-section">
  <h2 class="section-title"><%= catName %></h2>
  <table class="data-table">
    <thead>
      <tr>
        <th>Group</th>
        <th>Order</th>
        <th>Question</th>
        
        <th>Type</th>
        
        <th>Required</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% byCategory[catName].forEach(q => { %>
      <tr>
        <td><span class="badge"><%= q.group_index %></span></td>
        <td><%= q.order_index %></td>
        <td><%= q.question_text %></td>
       
        <td><span class="type-badge type-<%= q.field_type %>"><%= q.field_type %></span></td>
        
        <td><%= q.is_required ? '✔' : '—' %></td>
        <td class="action-cell">
          <a href="/admin/questions/<%= q.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
          <form method="POST" action="/admin/questions/<%= q.id %>/delete"
                onsubmit="return confirm('Delete this question?')" style="display:inline">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<% }) %>

<%- include('../../partials/footer') %>
