<%- include('../../partials/header', { title: 'Manage Locations' }) %>

<div class="page-header">
  <h1>Manage Locations</h1>
  <a href="/admin/locations/new" class="btn btn-primary">+ Add Location</a>
</div>

<% if (locations.length === 0) { %>
  <div class="alert alert-info">No locations yet. Add one using the button above.</div>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Location Name</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% locations.forEach(function(loc, i) { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= loc.name %></td>
          <td><%= new Date(loc.created_at).toLocaleDateString() %></td>
          <td class="table-actions">
            <a href="/admin/locations/<%= loc.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
            <form method="POST" action="/admin/locations/<%= loc.id %>/delete"
                  style="display:inline"
                  onsubmit="return confirm('Delete: <%= loc.name %>?')">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<div style="margin-top: 1.5rem;">
  <a href="/admin/questions" class="btn btn-secondary">← Back to Questions</a>
</div>

<%- include('../../partials/footer') %>
